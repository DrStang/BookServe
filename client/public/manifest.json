{
  "name": "BookServe",
  "short_name": "BookServe",
  "description": "Your personal digital book library - read, manage, and discover books",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#141414",
  "theme_color": "#e50914",
  "orientation": "any",
  "scope": "/",
  "lang": "en",
  "categories": ["books", "entertainment", "education"],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Browse your book library",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/library-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Continue Reading",
      "short_name": "Reading",
      "description": "Continue where you left off",
      "url": "/dashboard?filter=continue",
      "icons": [{ "src": "/icons/reading-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search your library",
      "url": "/search",
      "icons": [{ "src": "/icons/search-96x96.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "BookServe Dashboard"
    },
    {
      "src": "/screenshots/reader-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Book Reader"
    },
    {
      "src": "/screenshots/dashboard-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Library View"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": [".epub", ".pdf", ".mobi", "application/epub+zip", "application/pdf"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-book",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/pdf": [".pdf"],
        "application/x-mobipocket-ebook": [".mobi", ".azw", ".azw3"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+bookserve",
      "url": "/protocol?uri=%s"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
