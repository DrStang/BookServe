{
  "name": "bookserve",
  "version": "1.0.0",
  "description": "A Plex-like media server for digital books",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
    "server": "nodemon server/index.js",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": ["books", "epub", "media-server", "library"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.0",
    "nodemailer": "^6.9.7",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "adm-zip": "^0.5.10",
    "form-data": "^4.0.5",
    "xml2js": "^0.6.2",
    "csv-parser": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "node-calibre": "^2.0.2",
    "redis": "^4.6.12",
    "apollo-server-express": "^3.13.0",
    "graphql": "^16.8.1",
    "ollama": "^0.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
