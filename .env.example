# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/bookserve.db

# JWT Secret (change this!)
JWT_SECRET=your-secret-key-change-this

# File Storage
BOOKS_STORAGE_PATH=./data/books
COVERS_STORAGE_PATH=./data/covers
CONVERTED_BOOKS_PATH=./data/converted
TEMP_UPLOAD_PATH=./data/temp

# NZBHydra Configuration
NZBHYDRA_URL=http://localhost:5076
NZBHYDRA_API_KEY=your-nzbhydra-api-key

# SABnzbd Configuration
SABNZBD_URL=http://localhost:8080/sabnzbd
SABNZBD_API_KEY=your-sabnzbd-api-key
SABNZBD_DOWNLOAD_PATH=./data/downloads

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Redis Cache
REDIS_URL=redis://localhost:6379

# Ollama AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Google Books API (optional, increases rate limits)
GOOGLE_BOOKS_API_KEY=

# Auto-Import Configuration
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_INTERVAL=300000
DELETE_AFTER_IMPORT=true
AUTO_FETCH_METADATA=true

# Retry Service Configuration
RETRY_ENABLED=true
RETRY_CHECK_INTERVAL=21600000
RETRY_INTERVAL_DAYS=3

# Folder Scan Configuration
FOLDER_SCAN_ENABLED=true
FOLDER_SCAN_INTERVAL=300000

# AI Cache Service Configuration
AI_CACHE_ENABLED=true
AI_AUTO_UPDATE_DAYS=3

# Configuration Notes:
# - AI_CACHE_ENABLED: Enable/disable background AI cache updates
# - AI_AUTO_UPDATE_DAYS: How often to automatically refresh AI recommendations/insights (in days)
# - The AI cache will also be updated when:
#   * A book is marked as finished (90%+ progress)
#   * A new book is added to the library
#   * A Goodreads import is completed
#   * Manual trigger via API endpoint
